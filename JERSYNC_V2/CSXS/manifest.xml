<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest
    ExtensionBundleId="com.solocreative.jersyncv2"
    ExtensionBundleVersion="2.1.0"
    Version="5.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <ExtensionList>
        <Extension Id="com.solocreative.jersyncv2.panel" Version="2.1.0"/>
    </ExtensionList>

    <ExecutionEnvironment>
        <HostList>
            <Host Name="ILST" Version="[24.0,99.9]"/>
        </HostList>
        <LocaleList>
            <Locale Code="All"/>
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="9.0"/>
        </RequiredRuntimeList>
    </ExecutionEnvironment>

    <DispatchInfoList>
        <Extension Id="com.solocreative.jersyncv2.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./host/index.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>JERSYNC V2</Menu>
                    <Geometry>
                        <Size><Width>360</Width><Height>560</Height></Size>
                        <MinSize><Width>320</Width><Height>420</Height></MinSize>
                        <MaxSize><Width>900</Width><Height>1200</Height></MaxSize>
                    </Geometry>
                    <Icons/>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
